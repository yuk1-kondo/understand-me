# Copy to .env and fill in locally. Real values live in the Secure Vault — never commit them.
# Discord bot token (created by the project owner; plugged in after the receiver is built)
DISCORD_BOT_TOKEN=
# Numeric ID of the test voice channel the bot joins
DISCORD_CHANNEL_ID=
# Telegram bot token (from BotFather)
TELEGRAM_BOT_TOKEN=
# Core backend base URL the bots post to
BACKEND_URL=http://localhost:8000
# Speech-to-text provider: 'whisper' (local faster-whisper) or 'fake' (canned text)
STT_PROVIDER=whisper
# faster-whisper model size (whisper provider only)
WHISPER_MODEL=large-v3-turbo
# Reserved: speech-to-text provider key (backend only, if a cloud STT is added)
STT_API_KEY=
# Reserved: Claude API key (internal AI component: slot extraction / diff; backend only)
ANTHROPIC_API_KEY=
# Optional: TypeSafe AI key — enables the Jev judgment layer in the core
# (instruction detection + agreement check). Unset = rule-based only.
TYPESAFE_API_KEY=
